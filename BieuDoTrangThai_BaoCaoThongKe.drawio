<mxfile host="app.diagrams.net" modified="2026-11-11T11:15:00.000Z" agent="5.0" version="21.0.0" type="device">
  <diagram id="diagram_state_thongke" name="Biểu đồ trạng thái Báo cáo thống kê">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="780" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TIÊU ĐỀ BIỂU ĐỒ -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;BIỂU ĐỒ TRẠNG THÁI: PHÂN HỆ BÁO CÁO THỐNG KÊ (DASHBOARD)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 12px; font-weight: normal; color: #555555;&quot;&gt;Hệ thống Website Bán Điện Thoại Di Động NDN Mobile&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="600" height="45" as="geometry" />
        </mxCell>

        <!-- TRẠNG THÁI KHỞI TẠO (START NODE) -->
        <mxCell id="start_node" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="535" y="85" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- STATE 1: KHỞI TẠO BÁO CÁO MẶC ĐỊNH -->
        <mxCell id="state_default" value="&lt;b&gt;Khởi tạo báo cáo mặc định&lt;/b&gt;&lt;hr/&gt;&lt;span style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;entry / Nạp năm hiện tại (date(&#39;Y&#39;))&lt;br/&gt;do / Tổng hợp 5 chỉ số KPI toàn hệ thống&lt;/span&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="155" width="240" height="65" as="geometry" />
        </mxCell>

        <!-- STATE 2: HIỂN THỊ KẾT QUẢ THỐNG KÊ -->
        <mxCell id="state_display" value="&lt;b&gt;Hiển thị kết quả thống kê&lt;/b&gt;&lt;hr/&gt;&lt;span style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;• Biểu đồ doanh thu &amp;amp; đơn hàng 12 tháng&lt;br/&gt;• Biểu đồ phân bổ tỷ lệ trạng thái đơn&lt;br/&gt;• Top 5 sản phẩm bán chạy &amp;amp; Cảnh báo kho&lt;br/&gt;• Danh sách đơn hàng &amp;amp; đánh giá mới&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="415" y="275" width="270" height="95" as="geometry" />
        </mxCell>

        <!-- STATE 3: ĐANG TRUY VẤN DỮ LIỆU -->
        <mxCell id="state_query" value="&lt;b&gt;Đang truy vấn &amp;amp; tổng hợp dữ liệu&lt;/b&gt;&lt;hr/&gt;&lt;span style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;entry / Nhận tham số năm (GET ?year=...)&lt;br/&gt;do / Lấy đơn hàng theo tháng (orders_follow_month)&lt;br/&gt;do / Tính tổng doanh thu &amp;amp; đếm đơn hàng&lt;/span&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="405" y="445" width="290" height="75" as="geometry" />
        </mxCell>

        <!-- STATE 4: THÔNG BÁO KHÔNG CÓ DỮ LIỆU -->
        <mxCell id="state_nodata" value="&lt;b&gt;Thông báo không có dữ liệu&lt;/b&gt;&lt;hr/&gt;&lt;span style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;• Biểu đồ về giá trị 0&lt;br/&gt;• Hiển thị thông báo chưa phát sinh đơn&lt;br/&gt;• Gợi ý chọn mốc thời gian khác&lt;/span&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="810" y="445" width="220" height="75" as="geometry" />
        </mxCell>

        <!-- STATE 5: XUẤT / IN BÁO CÁO -->
        <mxCell id="state_export" value="&lt;b&gt;Xuất / In báo cáo&lt;/b&gt;&lt;hr/&gt;&lt;span style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;entry / Khởi tạo lệnh in (window.print)&lt;br/&gt;do / Kết xuất định dạng in ấn / PDF&lt;/span&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="810" y="285" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- STATE 6: ĐIỀU HƯỚNG CHI TIẾT NGHIỆP VỤ -->
        <mxCell id="state_navigate" value="&lt;b&gt;Điều hướng chi tiết nghiệp vụ&lt;/b&gt;&lt;hr/&gt;&lt;span style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;• Xem tất cả đơn hàng (admin/orders)&lt;br/&gt;• Quản lý tồn kho sản phẩm (admin/product)&lt;br/&gt;• Kiểm duyệt đánh giá (admin/reviews)&lt;/span&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="250" height="75" as="geometry" />
        </mxCell>

        <!-- TRẠNG THÁI KẾT THÚC (END NODE: BULLSEYE) -->
        <mxCell id="end_outer" value="" style="ellipse;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
